# =============================================================================
# 本地开发环境变量模板
#
# 用法：
#   1. 复制为 .env：Copy-Item .env.example .env
#   2. 填入自己的密码 / Key；.env 已被 .gitignore 忽略，不要提交
#   3. docker compose 会自动读取 .env
#   4. 本地启动 Spring Boot 前，在同一个 PowerShell 里执行：
#        . .\scripts\load-env.ps1
#      然后再 mvn spring-boot:run
# =============================================================================

# ---------- MySQL / Redis / RabbitMQ ----------
# docker compose 的 MySQL root 密码；本地已有 MySQL 时改成自己的密码
DB_PASSWORD=change-me-db
REDIS_PASSWORD=change-me-redis
RABBITMQ_PASSWORD=guest

# ---------- 项目一 JWT ----------
# 必须是足够长的随机串；改完后旧 token 全部失效，需要重新登录
JWT_SECRET=change-me-please-use-a-long-random-string-at-least-32-chars

# ---------- Chat 模型（OpenAI 兼容） ----------
# DeepSeek：https://api.deepseek.com
# 模型名按你的服务商实际可用值填写（如 deepseek-chat / deepseek-flash）
API_KEY=
BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-flash

# ---------- Embedding 模型（RAG 用，独立于 Chat） ----------
# 硅基流动 BAAI/bge-m3：https://api.siliconflow.cn
# 注意：base-url 不要带 /v1，Spring AI 会自己拼 /v1/embeddings
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL=BAAI/bge-m3

# ---------- Milvus ----------
MILVUS_HOST=localhost
MILVUS_PORT=19530
