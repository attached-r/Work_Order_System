  "components": {
    "schemas": {
      "UpdateUserDTO": {
        "type": "object",
        "description": "修改用户基本信息请求",
        "properties": {
          "realName": {
            "type": "string",
            "description": "真实姓名",
            "maxLength": 50,
            "minLength": 0
          },
          "phone": {
            "type": "string",
            "description": "联系电话,可空",
            "maxLength": 20,
            "minLength": 0
          },
          "departmentId": {
            "type": "integer",
            "format": "int64",
            "description": "所属部门ID,可空表示不调整"
          }
        },
        "required": [
          "realName"
        ]
      },
      "ResultVoid": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {},
          "timestamp": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "UpdateUserStatusDTO": {
        "type": "object",
        "description": "修改账号状态请求",
        "properties": {
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "账号状态:0禁用 1启用",
            "maximum": 1,
            "minimum": 0
          }
        },
        "required": [
          "status"
        ]
      },
      "AssignRoleDTO": {
        "type": "object",
        "description": "分配角色请求",
        "properties": {
          "roleIds": {
            "type": "array",
            "description": "角色ID列表,至少一个",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "minItems": 1
          }
        },
        "required": [
          "roleIds"
        ]
      },
      "ResetPasswordDTO": {
        "type": "object",
        "description": "重置密码请求",
        "properties": {
          "newPassword": {
            "type": "string",
            "description": "新密码",
            "maxLength": 2147483647,
            "minLength": 6
          }
        },
        "required": [
          "newPassword"
        ]
      },
      "AssignDepartmentDTO": {
        "type": "object",
        "description": "调整所属部门请求",
        "properties": {
          "departmentId": {
            "type": "integer",
            "format": "int64",
            "description": "部门ID"
          }
        },
        "required": [
          "departmentId"
        ]
      },
      "AssignPermissionDTO": {
        "type": "object",
        "description": "分配权限请求",
        "properties": {
          "permissionIds": {
            "type": "array",
            "description": "权限ID列表,可为空列表表示清空",
            "items": {
